{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    // Disabled to avoid a known TypeScript monorepo bug: without this,
    // tRPC throws a "cannot be named without a reference" error when
    // inferring types across packages, caused by how Bun resolves symlinks.
    // See: https://discord-questions.trpc.io/m/1170736851775127564
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
, "../../packages/db/auth-schema.ts"  ],
  "exclude": ["node_modules"]
}
